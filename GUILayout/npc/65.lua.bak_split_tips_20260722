local function toNumber(value, defaultValue)
    local num = tonumber(value)
    if num == nil then
        return defaultValue or 0
    end
    return num
end

local function safeDecode(msgData)
    if type(msgData) ~= "string" or msgData == "" then
        return nil
    end
    return SL:JsonDecode(msgData, false)
end

