                confirmProtectAndSend("segment", 3, state.idx, "是否在断代失败时自动使用断代护符？")
            end, getUnknownItemName(state.idx))
        end)
    else
        -- renderCostList(node, 455, 145, buildStageCost("final"))

        local btnCollect = GUI:Button_Create(node, "btn_collect", 420, 135, BTN_COLLECT)
        GUI:addOnClickEvent(btnCollect, function()
            sendStageAction(5, state.idx, false, {preview = 1})
        end)

        if tonumber(state.can_final) == 1 then
            local btnFinal = GUI:Button_Create(node, "btn_final", 512 + 137, 120, BTN_FINAL)
            GUI:addOnClickEvent(btnFinal, function()
                openStageConfirm(node, "final", buildStageCost("final"), function()
                    if not hasEnoughCost(buildStageCost("final")) then
                        sendStageAction(4, state.idx, false)
                        return
                    end
                    confirmProtectAndSend("final", 4, state.idx, "是否在终极鉴定失败时自动使用终鉴护符？")
                end, getUnknownItemName(state.idx))
            end)
        else
            GUI:setPositionX(btnCollect, 605)
        end
    end

    -- local tip = GUI:Image_Create(node, "rule_tip", 402, 134, QUESTION_SKIN)
    -- bindRuleTip(tip)
end

local function renderResult(node, overlay)
    local resp = npc.response
    if not resp then
        return
    end
    local function claimResult()
        if npc.claiming then
            return
        end
        npc.claiming = true
        sendStageAction(6, tonumber(resp.idx or npc.selectedIdx), false, {claim = 1})
    end

    if not overlay then
        GUI:Image_Create(node, "root_bg", 0, 0, ROOT_BG)
    end
    local resultBg = GUI:Image_Create(node, "result_bg", 206, 152, RESULT_BG)
    GUI:setAnchorPoint(resultBg, 0, 0)

    local era = buildResultEra()
    local eraSkin = ERA_IMG[era] or ERA_IMG[6]
    local eraImg = GUI:Image_Create(node, "era_img", 666 - 30, 300, eraSkin)
    GUI:setAnchorPoint(eraImg, 0.5, 0.5)

    local itemName = tostring(resp.item or "")
        if itemName ~= "" then
            local resultItem = createItemIcon(node, "result_item", 490, 250, itemName, 1.0)
            if resp.collect == 1 then
                GUI:setTouchEnabled(resultItem, true)
                GUI:addOnClickEvent(resultItem, function()
                    claimResult()
                end)
                local claimArea = GUI:Layout_Create(node, "result_item_claim_area", 450, 210, 80, 80, false)
                GUI:setTouchEnabled(claimArea, true)
                GUI:addOnClickEvent(claimArea, function()
                    claimResult()
                end)
            end
        -- local itemText = GUI:Text_Create(node, "result_name", 500, 188, 18, "#F7F0E1", itemName)
        -- GUI:setAnchorPoint(itemText, 0.5, 0.5)
        -- setTextStyle(itemText, "fonts/font4.ttf", "#000000", 2)
    end

    local resultBtn = GUI:Button_Create(node, "result_btn", 200 + 180, 160, RESULT_COLLECT)
    GUI:addOnClickEvent(resultBtn, function()
        claimResult()
    end)
end

render = function(node)
    if not node then
        return
    end
    GUI:removeAllChildren(node)

    if npc.response and (npc.response.result == "fake" or npc.response.result == "conservative" or npc.response.result == "final" or npc.response.result == "collect" or npc.response.result == "collect_preview") then
        renderResult(node)
        return
    end

    if getActiveState() then
        renderStageTwo(node)
        return
    end

    renderStageOne(node)
end

function npc.main(npcid, p2, p3, msgData)
    local data = safeDecode(msgData) or {}

    if p2 == 0 then
        npc.response = nil
        npc.state = type(data.gwjd) == "table" and data.gwjd or nil
        if npc.state and tonumber(npc.state.idx) then
            npc.selectedIdx = tonumber(npc.state.idx)
        end
        ensureWindow(npcid)
        npc.npcid = npcid
        render(npc.node)
        return
    end

    if tonumber(data.idx) then
        npc.selectedIdx = tonumber(data.idx)
    end

    if data.result == "true" or data.result == "segment" then
        npc.state = {
            active = 1,
            idx = tonumber(data.idx) or npc.selectedIdx,
            era = tonumber(data.era) or 6,
            stage = tonumber(data.stage) or 1,
            can_final = tonumber(data.can_final) or 0,
            collect_pending = tonumber(data.collect) or 0,
        }
        npc.response = data
    elseif data.result == "final" then
        npc.state = {
            active = 1,
            idx = tonumber(data.idx) or npc.selectedIdx,
            era = tonumber(data.era) or 6,
            stage = 2,
            can_final = 0,
            collect_pending = tonumber(data.collect) or 1,
        }
        npc.response = data
    elseif data.result == "collect_preview" then
        npc.state = {
            active = 1,
            idx = tonumber(data.idx) or npc.selectedIdx,
            era = tonumber(data.era) or 6,
            stage = tonumber(data.stage) or 2,
            can_final = tonumber(data.can_final) or 0,
            collect_pending = tonumber(data.collect) or 1,
        }
        npc.response = data
    elseif data.result == "collect" then
        npc.claiming = false
        npc.state = nil
        npc.response = nil
        if not npc.node then
            ensureWindow(npcid)
        end
        npc.npcid = npcid
        render(npc.node)
        return
    elseif data.result == "fake" or data.result == "conservative" then
        npc.state = nil
        npc.response = data
    elseif type(data.gwjd) == "table" then
        npc.state = data.gwjd
        npc.response = nil
    end

    if not npc.node then
        ensureWindow(npcid)
    end
    npc.npcid = npcid
    render(npc.node)
end

return npc
