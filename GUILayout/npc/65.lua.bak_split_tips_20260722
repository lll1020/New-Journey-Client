local function hasEra(eraList, era)
    for _, one in ipairs(eraList or {}) do
        if tonumber(one) == tonumber(era) then
            return true
        end
    end
    return false
end

local function pickClueText(pool, era, seed)
    local matches = {}
    for _, one in ipairs(pool or {}) do
        if hasEra(one.eras, era) then
            table.insert(matches, one.text)
        end
    end
    if #matches <= 0 then
        return "懂得都懂，一言难尽..."
    end
    local idx = (toNumber(seed, 0) % #matches) + 1
    return matches[idx]
end

local function buildClueList(era, isFake, idx, stage)
    if isFake then
        return {
            "当前状态：未鉴定",
            "器形特征：未鉴定",
            "包浆痕迹：未鉴定",
        }
    end
    local seed = toNumber(idx, 0) * 10 + toNumber(stage, 0)
    return {
        "" .. pickClueText(CLUE_POOL.color, era, seed + 1),
        "" .. pickClueText(CLUE_POOL.pattern, era, seed + 2),
        "" .. pickClueText(CLUE_POOL.trace, era, seed + 3),
    }
end

