local function getStage2Banner()
    local resp = npc.response or {}
    if resp.result == "fake" then
        return STAGE2_FAKE
    end
    if resp.result == "segment" then
        return resp.success and STAGE2_SEGMENT_UP or STAGE2_SEGMENT_DOWN
    end
    return STAGE2_TRUE
end

local function sendStageAction(ew, stateIdx, useProtect, extra)
    local payload = {
        idx = stateIdx,
        use_protect = useProtect and 1 or 0
    }
    if type(extra) == "table" then
        for k, v in pairs(extra) do
            payload[k] = v
        end
    end
    SL:SendLuaNetMsg(100, npc.npcid, ew, 0, SL:JsonEncode(payload, false))
end

local function confirmProtectAndSend(phase, ew, stateIdx, tipText)
    local protectName = getProtectItemName(phase)
    if not protectName or protectName == "" or getProtectItemCount(phase) <= 0 then
        sendStageAction(ew, stateIdx, false)
        return
    end
    SL:OpenCommonTipsPop({
        str = tipText or string.format("检测到背包中有%s，是否在失败时自动使用？", tostring(protectName)),
        btnType = 2,
        callback = function(atype)
            if atype == 1 then
                sendStageAction(ew, stateIdx, true)
            else
                sendStageAction(ew, stateIdx, false)
            end
        end
    })
end

