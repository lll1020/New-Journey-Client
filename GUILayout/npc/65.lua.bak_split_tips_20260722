end

local function getItemCfg(idx)
    local cfg = getCfg()
    return cfg.config and cfg.config[idx] or nil
end

local function getSelectedCfg()
    return getItemCfg(npc.selectedIdx)
end

local function getUnidItemName(idx)
    local cfg = getItemCfg(idx)
    return cfg and (cfg.unid_item or (cfg.cost and cfg.cost[1] and cfg.cost[1][1])) or ""
end

local function getUnidItemIndex(idx)
    local name = getUnidItemName(idx)
    if name == "" then
        return 0
    end
    return toNumber(SL:GetMetaValue("ITEM_INDEX_BY_NAME", name), 0)
end

local function getEraName(era)
    local cfg = getCfg()
    local eras = cfg.eras or {}
    return tostring(eras[toNumber(era, 0)] or "近代")
end

local function getAntiqueItemName(idx, era)
    local cfg = getItemCfg(idx)
    if not cfg or not cfg.name then
        return ""
    end
    return string.format("【%s】%s", getEraName(era), tostring(cfg.name))
end

local function getUnknownItemName(idx)
    local cfg = getItemCfg(idx)
    if not cfg or not cfg.name then
        return getUnidItemName(idx)
    end
    local unidName = getUnidItemName(idx)
    if unidName and unidName ~= "" then
        return unidName
    end
    return string.format("【未鉴定】%s", tostring(cfg.name))
end

local function getBagItemCountByName(name)
    local idx = toNumber(SL:GetMetaValue("ITEM_INDEX_BY_NAME", name), 0)
    if idx <= 0 then
        return 0
    end
    return toNumber(SL:GetMetaValue("ITEM_COUNT", idx), 0)
end

local function hasEnoughCost(cost)
    if not cost or #cost <= 0 then
        return true
    end
    local lackName = Player:checkItemNumByTable(cost)
    return lackName == nil
end

local function getProtectItemName(phase)
    local cfg = getCfg()
    return cfg.protect_item and cfg.protect_item[phase] or nil
end

local function getProtectItemCount(phase)
    local name = getProtectItemName(phase)
    if not name or name == "" then
        return 0
    end
    return getBagItemCountByName(name)
end

local function getIdentifyCost(idx)
    local cfg = getCfg()
    local cost = {}
    local unidItem = getUnidItemName(idx)
    if unidItem ~= "" then
        table.insert(cost, {unidItem, 1})
    end
    for _, one in ipairs(cfg.cost and cfg.cost.identify or {}) do
        table.insert(cost, one)
    end
    return cost
end

