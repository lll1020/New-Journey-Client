local npc = {}

local function n(v, d)
    local x = tonumber(v)
    if x == nil then return d or 0 end
    return x
end

local STONES = {
    {name = "聚宝魔石", time = "30分钟", desc = "全大陆掉落，炼灵后随机获得灵石、金币或千年玄铁。"},
    {name = "极光·专属宝石·绑定", time = "2小时", desc = "产出二大陆专属装备，装备绑定。"},
    {name = "苍云·专属宝石·绑定", time = "6小时", desc = "产出三大陆专属装备，装备绑定。"},
    {name = "若水·专属宝石·绑定", time = "12小时", desc = "产出四大陆专属装备，装备绑定。"},
    {name = "红尘·专属宝石·绑定", time = "24小时", desc = "产出五大陆专属装备，装备绑定。"},
    {name = "灵虚·专属宝石·绑定", time = "48小时", desc = "产出六大陆专属装备，装备绑定。"},
    {name = "极光·专属宝石·非绑", time = "2小时", desc = "产出二大陆专属装备，可交易。"},
    {name = "苍云·专属宝石·非绑", time = "6小时", desc = "产出三大陆专属装备，可交易。"},
    {name = "若水·专属宝石·非绑", time = "12小时", desc = "产出四大陆专属装备，可交易。"},
    {name = "红尘·专属宝石·非绑", time = "24小时", desc = "产出五大陆专属装备，可交易。"},
    {name = "灵虚·专属宝石·非绑", time = "48小时", desc = "产出六大陆专属装备，可交易。"},
}

local WINDOW_OPTS = {
    background = {skin = "res/wy/public/*.png"},
    closeButton = {x = 330, y = 180, skin = "res/wy/public/close_red_big.png"},
}

local tab = 1
local selectedStone = 1

local function data()
    return npc.data or {}
end

local function fmt(v)
    v = math.floor(n(v))
    if v >= 100000000 then return tostring(math.floor(v / 100000000)) .. "亿" end
    if v >= 10000 then return tostring(math.floor(v / 10000)) .. "万" end
    return tostring(v)
end

local function text(parent, name, x, y, size, color, value, ax)
    local t = GUI:Text_Create(parent, name, x, y, size, color, tostring(value or ""))
    GUI:setAnchorPoint(t, ax or 0.5, 0.5)
    GUI:Text_enableOutline(t, "#120B05", 1)
    return t
end

local function rect(parent, name, x, y, w, h, color)
    local node = GUI:Layout_Create(parent, name, x, y, w, h, false)
    GUI:setBackGroundColorType(node, 1)
    GUI:setBackGroundColor(node, color or "#2B1A10")
    GUI:setBackGroundColorOpacity(node, 170)
    GUI:setAnchorPoint(node, 0.5, 0.5)
    return node
end

local function button(parent, name, x, y, w, h, title, cb)
    local b = GUI:Button_Create(parent, name, x, y, "res/public/1900000660.png")
    GUI:setContentSize(b, w, h)
    GUI:Button_setTitleText(b, title or "")
    GUI:Button_setTitleFontSize(b, 16)
    GUI:Button_setTitleColor(b, "#FFE2A0")
    GUI:setAnchorPoint(b, 0.5, 0.5)
    GUI:addOnClickEvent(b, cb)
    return b
end

local function ensureWindow(npcid)
    npc._window = NPC_UI_HELPER.ensureWindow(npc._window, npcid, WINDOW_OPTS)
    npc.bg = npc._window.bg
    GUI:setLocalZOrder(npc._window.node, 99)
    if not npc.node then
        npc.node = GUI:Node_Create(npc.bg, "node", 500, 360)
    end
    return npc.node
end

local function renderTabs(node, npcid)
    local names = {"聚能收益", "炼灵宝石", "禁器"}
    for i, name in ipairs(names) do
        local b = button(node, "tab_" .. i, -210 + (i - 1) * 210, 128, 150, 42, name, function()
            tab = i
            npc.render(npcid)
        end)
        GUI:Button_setTitleColor(b, tab == i and "#FFF2B8" or "#C8A66A")
    end
end

local function renderHeader(node)
    local d = data()
    text(node, "title", 0, 178, 28, "#FFD36A", "聚宝盆", 0.5)
    text(node, "level", 0, 145, 18, "#9DFF7C", string.format("%s  Lv.%d  炼灵倍率：%d%%", tostring(d.level_name or "凡品聚宝盆"), n(d.level, 1), math.floor(n(d.speed, 1) * 100)), 0.5)
end

local function renderEnergy(node, npcid)
    local d = data()
    local r = d.energy_reward or {}
    rect(node, "energy_panel", 0, -20, 560, 245, "#241408")
    text(node, "energy_name", 0, 78, 22, "#FFE2A0", "聚能收益", 0.5)
    if n(d.activated) < 1 then
        text(node, "energy_locked", 0, 25, 20, "#FF5A3D", "请先完成二大陆聚宝盆主线任务", 0.5)
        text(node, "energy_locked_desc", 0, -15, 16, "#F2E7C8", "完成后获得聚宝盆背包神器，穿戴后可查看聚能进度。", 0.5)
        return
    end
    text(node, "energy_time", 0, 42, 18, "#9FE2FF", "当前存储时长：" .. tostring(d.energy_text or "00:00"), 0.5)
    text(node, "energy_cap", 0, 14, 16, "#F4D179", "存储上限：" .. tostring(d.cap_text or "无存储"), 0.5)
    text(node, "energy_help", 0, -16, 15, "#B9F6C5", "在线按完整收益累计，离线收益为在线的50%；领取后存储时间清零。", 0.5)
    text(node, "energy_reward", 0, -54, 18, "#FFDD77", string.format("可领取：金币%s  千年玄铁%s  斗笠碎片%s", fmt(r.gold), fmt(r.iron), fmt(r.hat)), 0.5)
    button(node, "claim_energy", 0, -104, 160, 44, "领取聚能", function()
        SL:SendLuaNetMsg(100, npcid, 1, 0, "")
    end)
end

local function renderRefine(node, npcid)
    local d = data()
    local ref = d.refine or {}
    rect(node, "refine_left", -180, -20, 250, 245, "#241408")
    rect(node, "refine_right", 165, -20, 310, 245, "#1D160C")
    text(node, "refine_title", -180, 82, 20, "#FFE2A0", "宝石选择", 0.5)
    for i = 1, 6 do
        local cfg = STONES[i]
        local y = 50 - (i - 1) * 28
        local b = button(node, "stone_" .. i, -180, y, 210, 24, cfg.name, function()
            selectedStone = i
            npc.render(npcid)
        end)
        GUI:Button_setTitleFontSize(b, 13)
        GUI:Button_setTitleColor(b, selectedStone == i and "#9DFF7C" or "#E8C88A")
    end
    local cfg = STONES[selectedStone] or STONES[1]
    text(node, "sel_name", 165, 78, 20, "#FFD36A", cfg.name, 0.5)
    text(node, "sel_time", 165, 44, 16, "#9FE2FF", "基础炼灵时间：" .. cfg.time, 0.5)
    text(node, "sel_desc", 165, 10, 15, "#F2E7C8", cfg.desc, 0.5)
    if n(ref.active) >= 1 then
        local done = n(ref.done) >= 1
        text(node, "ref_status", 165, -38, 17, done and "#9DFF7C" or "#FFB85A", done and "炼灵完成，可领取" or ("炼灵中：" .. tostring(ref.left or 0) .. "秒"), 0.5)
        button(node, "claim_refine", 165, -96, 160, 42, "领取产物", function()
            SL:SendLuaNetMsg(100, npcid, 3, 0, "")
        end)
    else
        text(node, "ref_status", 165, -38, 17, "#B9F6C5", "当前空闲，可放入一枚宝石。", 0.5)
        button(node, "start_refine", 165, -96, 160, 42, "开始炼灵", function()
            SL:SendLuaNetMsg(100, npcid, 2, 0, SL:JsonEncode({stone = cfg.name}))
        end)
    end
end

local function renderForbidden(node, npcid)
    local d = data()
    text(node, "point", 0, 92, 18, "#9DFF7C", "聚宝值：" .. fmt(d.forbidden_point), 0.5)
    local list = d.forbidden or {}
    for i = 1, 3 do
        local f = list[i] or {}
        local x = -220 + (i - 1) * 220
        rect(node, "forbid_card_" .. i, x, -22, 190, 245, "#241408")
        text(node, "forbid_name_" .. i, x, 68, 16, "#FFD36A", tostring(f.name or "禁器"), 0.5)
        text(node, "forbid_grade_" .. i, x, 36, 16, "#9FE2FF", "品阶：" .. tostring(f.grade or "未激活"), 0.5)
        text(node, "forbid_skill_" .. i, x, 8, 15, "#F4D179", "技能：" .. tostring(f.skill or ""), 0.5)
        text(node, "forbid_used_" .. i, x, -20, 15, n(f.used) >= 1 and "#FF5A3D" or "#9DFF7C", n(f.used) >= 1 and "今日已释放" or "今日可释放", 0.5)
        button(node, "forbid_unlock_" .. i, x - 48, -62, 82, 30, n(f.lv) > 0 and "升级" or "激活", function()
            SL:SendLuaNetMsg(100, npcid, n(f.lv) > 0 and 5 or 4, i, "")
        end)
        button(node, "forbid_show_" .. i, x + 48, -62, 82, 30, n(f.show) >= 1 and "外显中" or "外显", function()
            SL:SendLuaNetMsg(100, npcid, 6, i, "")
        end)
        button(node, "forbid_skill_btn_" .. i, x, -105, 112, 30, "释放技能", function()
            SL:SendLuaNetMsg(100, npcid, 7, i, "")
        end)
    end
end

function npc.render(npcid)
    local node = ensureWindow(npcid)
    GUI:removeAllChildren(node)
    renderHeader(node)
    renderTabs(node, npcid)
    if tab == 1 then
        renderEnergy(node, npcid)
    elseif tab == 2 then
        renderRefine(node, npcid)
    else
        renderForbidden(node, npcid)
    end
end

function npc.main(npcid, p2, p3, msgData)
    if msgData and msgData ~= "" then
        npc.data = SL:JsonDecode(msgData, false) or npc.data or {}
    else
        npc.data = npc.data or {}
    end
    npc.render(npcid)
end

return npc
