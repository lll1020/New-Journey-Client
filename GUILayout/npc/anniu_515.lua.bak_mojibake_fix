local function buildSpecialSummaryText(localSpecialMap)
    local lines = {}
    local rendered = {}
    local serverSpecialMap = npc.data and npc.data.special or {}

    for _, info in ipairs(npc.data and npc.data.fake_attr or {}) do
        local text = tostring(info.text or "")
        local key = tostring(info.key or "")
        if text ~= "" then
            lines[#lines + 1] = string.format("<font color='#68ecff'>%s</font>", formatAttrPanelText(text))
            if key ~= "" then
                rendered[key] = true
            end
        end
    end

    local keys = {}
    for key, _ in pairs(localSpecialMap or {}) do
        if not rendered[key] then
            keys[#keys + 1] = key
        end
    end
    for key, _ in pairs(serverSpecialMap or {}) do
        if not rendered[key] then
            keys[#keys + 1] = key
        end
    end
    table.sort(keys)

    local visited = {}
    for _, key in ipairs(keys) do
        if not visited[key] then
            visited[key] = true
            local cfg = SPECIAL_PANEL_CFG[key]
            local value = toNumber(serverSpecialMap[key], toNumber(localSpecialMap[key], 0))
            if cfg and value > 0 then
                local valueText = cfg.percent and formatPanelPercent(value) or tostring(value)
                lines[#lines + 1] = string.format("<font color='#68ecff'>%s+%s</font>", formatAttrPanelText(cfg.name), valueText)
            end
        end
    end

    return table.concat(lines, "\n")
end

-- 鍙充晶鈥滄垚灏卞睘鎬р€濆彧姹囨€诲凡婵€娲绘垚灏变骇鐢熺殑甯搁┗灞炴€т笌 fake_attr 灞曠ず鏂囨銆?local function buildAttrSummaryText()
    local summaryMap = {}
    local summaryOrder = {}

    local function normalizeLabel(label)
        label = tostring(label or "")
        label = SUMMARY_TEXT_ALIAS[label] or label
        return formatAttrPanelText(label)
    end

    local function resolveSummaryColor(label, color, isPercent)
        label = normalizeLabel(label)
        color = tostring(color or "")
        if color ~= "" then
            return color
        end
        local cfgColor = npc._config and npc._config.attr_show_color and npc._config.attr_show_color[label]
        if tostring(cfgColor or "") ~= "" then
            return tostring(cfgColor)
        end
        return isPercent and "#ffe39a" or "#ffffff"
    end

    local function ensureSummary(label, color, isPercent, sign)
        label = normalizeLabel(label)
        if label == "" then
            return nil
        end
        local finalColor = resolveSummaryColor(label, color, isPercent)
        local node = summaryMap[label]
        if not node then
            node = {label = label, color = finalColor, percent = isPercent and true or false, value = 0, min = 0, max = 0, mode = "value", sign = sign or "+"}
            summaryMap[label] = node
            summaryOrder[#summaryOrder + 1] = label
        end
        node.percent = node.percent or (isPercent and true or false)
        node.color = resolveSummaryColor(label, color, node.percent)
        if sign then
            node.sign = sign
        end
        return node
    end

    local function addValue(label, value, isPercent, color, sign)
        value = toNumber(value, 0)
        if value == 0 then
            return
        end
        local node = ensureSummary(label, color, isPercent, sign)
        if not node then
            return
        end
        if node.mode ~= "range" then
            node.mode = "value"
        end
        node.value = node.value + value
    end

    local function addRange(label, minValue, maxValue, color, sign)
        minValue = toNumber(minValue, 0)
        maxValue = toNumber(maxValue, 0)
        if minValue == 0 and maxValue == 0 then
            return
        end
        local node = ensureSummary(label, color, false, sign)
        if not node then
            return
        end
        node.mode = "range"
        node.min = node.min + minValue
        node.max = node.max + maxValue
    end

    local function formatSummaryValue(value, isPercent)
        if isPercent then
            return formatPanelPercent(value)
        end
        return tostring(value)
    end

    for _, detail in ipairs(getAllDetails()) do
        if isDetailDone(detail.id) then
            for _, info in ipairs(detail.attr_show or {}) do
                local label = tostring(info.label or "")
                local color = tostring(info.color or "")
                local sign = tostring(info.sign or "+")
                if tostring(info.mode or "") == "range" then
                    addRange(label, info.min, info.max, color, sign)
                else
                    local isPercent = info.percent == true or toNumber(info.percent, 0) >= 1
                    addValue(label, info.value, isPercent, color, sign)
                end
            end
        end
    end

    local lines = {}
    for _, label in ipairs(summaryOrder) do
        local node = summaryMap[label]
        if node then
            local text = ""
            if node.mode == "range" then
                if node.min > 0 and node.max > 0 and node.min ~= node.max then
                    text = string.format("%s%s%s-%s", node.label, node.sign or "+", tostring(node.min), tostring(node.max))
                else
                    local showValue = math.max(node.min, node.max)
                    if showValue > 0 then
                        text = string.format("%s%s%s", node.label, node.sign or "+", tostring(showValue))
                    end
                end
            else
                if node.value > 0 then
                    text = string.format("%s%s%s", node.label, node.sign or "+", formatSummaryValue(node.value, node.percent))
                end
            end
            if text ~= "" then
                lines[#lines + 1] = string.format("<font color='%s'>%s</font>", node.color or "#ffffff", text)
            end
        end
    end

    if #lines == 0 then
        return "<font color='#7f8ca3'>鏆傛湭婵€娲讳换浣曟垚灏卞睘鎬?/font>"
    end
    return table.concat(lines, "\n")
end

local function normalizeDetailAttrLabel(label)
    label = tostring(label or "")
    label = SUMMARY_TEXT_ALIAS[label] or label
    return formatAttrPanelText(label)
end

local function resolveDetailAttrColor(label, color, isPercent)
    label = normalizeDetailAttrLabel(label)
    color = tostring(color or "")
    if color ~= "" then
        return color
    end
    local cfgColor = npc._config and npc._config.attr_show_color and npc._config.attr_show_color[label]
    if tostring(cfgColor or "") ~= "" then
        return tostring(cfgColor)
    end
    return isPercent and "#ffe39a" or "#ffffff"
end

local function buildUnlockAttrText(detail)
    local lines = {}
    for _, info in ipairs(detail and detail.attr_show or {}) do
        local label = normalizeDetailAttrLabel(info.label)
        if label ~= "" then
            local sign = tostring(info.sign or "+")
            local mode = tostring(info.mode or "")
            local color = resolveDetailAttrColor(label, info.color, info.percent == true or toNumber(info.percent, 0) >= 1)
            local text = ""
            if mode == "range" then
                local minValue = toNumber(info.min, 0)
                local maxValue = toNumber(info.max, 0)
                if minValue > 0 or maxValue > 0 then
                    if minValue ~= maxValue and minValue > 0 and maxValue > 0 then
                        text = string.format("%s%s%s-%s", label, sign, tostring(minValue), tostring(maxValue))
                    else
                        text = string.format("%s%s%s", label, sign, tostring(math.max(minValue, maxValue)))
                    end
                end
            else
                local value = toNumber(info.value, 0)
                if value > 0 then
                    local isPercent = info.percent == true or toNumber(info.percent, 0) >= 1
                    text = string.format("%s%s%s", label, sign, isPercent and formatPanelPercent(value) or tostring(value))
                end
            end
            if text ~= "" then
                lines[#lines + 1] = string.format("<font color='%s'>%s</font>", color, text)
            end
        end
    end
    return table.concat(lines, "\n")
end

