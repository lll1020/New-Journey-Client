local function normalizeSearchText(text)
    text = tostring(text or "")
    text = string.lower(text)
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    return text
end

-- 鎼滅储鍙鎴愬氨鍚嶇О鍋氭ā绯婂尮閰嶏紝浣嗕細鍏堝幓鎺夌┖鏍煎拰甯歌鏍囩偣銆?local function compactSearchText(text)
    text = normalizeSearchText(text)
    text = text:gsub("[%s%p%c]+", "")
    text = text:gsub("锛?, ""):gsub("銆?, ""):gsub("锛?, ""):gsub("锛?, "")
    text = text:gsub("锛?, ""):gsub("锛?, ""):gsub("銆?, ""):gsub("銆?, ""):gsub("銆?, "")
    return text
end

local function splitSearchTerms(text)
    local terms = {}
    text = normalizeSearchText(text)
    text = text:gsub("[锛屻€傦紱锛氥€乚+", " ")
    for term in string.gmatch(text, "%S+") do
        if term ~= "" then
            terms[#terms + 1] = term
        end
    end
    if #terms == 0 and text ~= "" then
        terms[1] = text
    end
    return terms
end

local function utf8SubsequenceMatch(source, key)
    if key == "" then
        return true
    end
    local pos = 1
    for char in string.gmatch(key, "[%z\1-\127\194-\244][\128-\191]*") do
        local _, endPos = string.find(source, char, pos, true)
        if not endPos then
            return false
        end
        pos = endPos + 1
    end
    return true
end

-- 褰撳墠闇€姹傦細鎼滅储鑼冨洿鍙湅 name锛屼笉鏌ユ潯浠?濂栧姳/鍒嗙粍銆?local function matchSearch(detail, key)
    if key == "" then
        return true
    end
    local source = normalizeSearchText(detail.name)
    local compactSource = compactSearchText(source)

    for _, term in ipairs(splitSearchTerms(key)) do
        local rawTerm = normalizeSearchText(term)
        local compactTerm = compactSearchText(term)
        if rawTerm ~= "" and string.find(source, rawTerm, 1, true) ~= nil then
            return true
        end
        if compactTerm ~= "" and string.find(compactSource, compactTerm, 1, true) ~= nil then
            return true
        end
        if compactTerm ~= "" and utf8SubsequenceMatch(compactSource, compactTerm) then
            return true
        end
        for char in string.gmatch(compactTerm, "[%z\1-\127\194-\244][\128-\191]*") do
            if char ~= "" and string.find(compactSource, char, 1, true) ~= nil then
                return true
            end
        end
    end
    return false
end

