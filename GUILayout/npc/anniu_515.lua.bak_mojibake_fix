local function parseBigNum(text)
    text = tostring(text or "")
    local value = tonumber(text)
    if value then
        return value
    end
    local raw = string.lower(text)
    local base = tonumber((raw:gsub("w", ""))) or 0
    if string.find(raw, "w", 1, true) then
        return base * 10000
    end
    return 0
end

local function splitRewardText(text)
    local ret = {}
    text = tostring(text or "")
    text = text:gsub("鍥哄畾鐢熷懡銆佸浐瀹氶瓟娉?+(%d+)", "鍥哄畾鐢熷懡+%1銆佸浐瀹氶瓟娉?%1")
    text = text:gsub("锛?, "銆?):gsub(",", "銆?)
    for part in string.gmatch(text, "[^銆乚+") do
        part = tostring(part):gsub("^%s+", ""):gsub("%s+$", "")
        if part ~= "" then
            ret[#ret + 1] = part
        end
    end
    return ret
end

