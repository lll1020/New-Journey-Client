    end

    parent = GUI:Win_Create(windowName, cogin.w / 2, cogin.h / 2 - 120, 0, 0, false, false, true, true, true, 515, 99)
    local bg = GUI:Image_Create(parent, "bg", 0, 0, "res/custom/fairyFate/閹存劕姘ㄧ憴锝夋敚/閹存劕姘ㄧ憴锝夋敚.png")
    GUI:setAnchorPoint(bg, 0.5, 0.5)

    local icon = GUI:Image_Create(bg, "icon", -86 + 160, -6 + 80 + 20, getAchievementIconByName((detail and detail.name) or info.name))
    GUI:setAnchorPoint(icon, 0.5, 0.5)

    local title = GUI:Text_Create(bg, "title", 20 + 203, 64, 20, "#ffe9ad", tostring((detail and detail.name) or info.name or "閹存劕姘ㄦ潏鐐灇"))
    GUI:setAnchorPoint(title, 0.5, 0.5)
    setTextStyle(title, "#ffe9ad", 20, "fonts/font4.ttf")

    local intro = tostring((detail and (detail.intro or detail.desc or detail.cond)) or info.desc or info.cond or "")
    if intro ~= "" then
        local introText = GUI:RichText_Create(bg, "intro", 20 + 203, 28, string.format("<font color='#8ca2bf'>介绍：</font><font color='#dfeaf7'>%s</font>", intro), 230, 14, "#dfeaf7", 1, nil, nil, {outlineSize = 1, outlineColor = "#100808"})
        GUI:setAnchorPoint(introText, 0.5, 0.5)
    end

    local reward = tostring((detail and detail.reward) or info.reward or "")
    if reward == "" then
        reward = buildUnlockAttrText(detail)
    end
    if reward ~= "" then
        local rewardText = GUI:RichText_Create(bg, "reward", 20 + 203, -18, string.format("<font color='#8ca2bf'>奖励：</font><font color='#8fe9ff'>%s</font>", reward), 230, 14, "#8fe9ff", 1, nil, nil, {outlineSize = 1, outlineColor = "#100808"})
        GUI:setAnchorPoint(rewardText, 0.5, 0.5)
    end

    GUI:Timeline_DelayTime(bg, 3000, function()
        local curParent = GUI:GetWindow(nil, windowName)
        if curParent then
            GUI:Win_Close(curParent)
        end
    end)
end

UI_updata = function(node)
    if not isValidGuiNode(node) or not isValidGuiNode(npc.bg) then
        clearWindowCache()
        return
    end

    GUI:removeAllChildren(node)

    renderTabs(node)

    if npc.currentTab == 1 then
        local panel = renderOverviewPanel(node, "overview_panel_bg")
        renderAttrPanel(panel)
        renderOverview(panel)
    else
        renderDetailPage(node, GROUP_ORDER[npc.currentTab])
    end
end

-- p2:
-- 0 = 鍒濆鍖栨暣鍖呮暟鎹?-- 2 = 鍗曟潯鎴愬氨瑙ｉ攣寮圭獥
-- 鍏朵粬 = 甯歌鍒锋柊
function npc.main(npcid, p2, p3, msgData)
    npc._npcid = npcid or npc._npcid

    if p2 == 0 then
        npc.currentTab = 1
        npc.milestonePage = 1
        npc.searchKey = ""
        npc.data = ensureData(safeDecode(msgData))
        refreshWindow(npcid)
        return
    end

    if p2 == 2 then
        local info = safeDecode(msgData) or {}
        npc.data = ensureData(npc.data)
        npc.data.T_data.done[tostring(p3)] = 1
        npc.data.done_count = countDone(npc.data.T_data.done)
        showUnlockToast(info, p3)
        if isValidGuiNode(npc.node) and isValidGuiNode(npc.bg) then
            refreshWindow(npcid)
        end
        return
    end

    local data = safeDecode(msgData)
    npc.data = ensureData(data or npc.data)
    refreshWindow(npcid)
end

return npc
