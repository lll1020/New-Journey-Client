    local cfg = SL:GetMetaValue("ATTR_CONFIG", attrId)
    value = toNumber(value, 0)
    if cfg and cfg.type == 2 then
        return formatPanelPercent(value)
    end
    if cfg and cfg.type == 3 then
        return formatPanelPercent(value)
    end
    return tostring(value)
end

local function buildAttrPanelText(attrMap)
    local lines = {}
    local consumed = {}

    local function pushMergedLine(id1, id2, mergedName)
        local v1 = toNumber(attrMap[id1], 0)
        local v2 = toNumber(attrMap[id2], 0)
        if v1 ~= 0 and v1 == v2 then
            lines[#lines + 1] = string.format(
                "<font color='#ffffff'>%s+%s</font>",
                mergedName,
                formatAttrPanelValue(id1, v1)
            )
            consumed[id1] = true
            consumed[id2] = true
        end
    end

    pushMergedLine(3, 4, "鏀诲嚮")
    pushMergedLine(5, 6, "榄旀硶")
    pushMergedLine(7, 8, "閬撴湳")
    pushMergedLine(9, 10, "闃插尽")

    local rest = {}
    for attrId, value in pairs(attrMap) do
        if toNumber(value, 0) ~= 0 and not consumed[attrId] then
            rest[#rest + 1] = {id = toNumber(attrId, 0), value = toNumber(value, 0)}
        end
    end
    table.sort(rest, function(a, b)
        return a.id < b.id
    end)

    for _, entry in ipairs(rest) do
        lines[#lines + 1] = string.format(
            "<font color='#ffffff'>%s+%s</font>",
            getAttrPanelName(entry.id),
            formatAttrPanelValue(entry.id, entry.value)
        )
    end

    return table.concat(lines, "\n")
end

