    end
    if text == "" or text == "暂无" then
        return "暂无"
    end
    local desc = _lg_color_skill_desc(text)
    if level <= 0 and not previewNext then
        desc = desc .. "<br><font color='#9FE2FF'>灵根达到Lv.1后激活。</font>"
    end
    return desc
end
