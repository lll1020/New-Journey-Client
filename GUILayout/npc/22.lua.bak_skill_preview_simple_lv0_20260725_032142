-- 将灵根效果文案中的“5000*灵根倍率+2000”一类公式直接结算为实际数值。
local function _lg_strip_html(text)
    local plain = tostring(text or "")
    plain = plain:gsub("<[^>]->", "")
    plain = plain:gsub("^%s+", "")
    plain = plain:gsub("%s+$", "")
